import java.util.Scanner;

/**
 * Modifica cada número sumándole el producto de sus índices.
 *
 * @author Jeremy Joel Valladarez Caballero
 */
public class Ejercicio10 {
    public static void main(String[] args) {
        Scanner entrada = new Scanner(System.in);
        int[][] matriz = new int[3][5];

        System.out.println("MATRIZ MODIFICADA 3 X 5");
        for (int fila = 0; fila < matriz.length; fila++) {
            for (int columna = 0; columna < matriz[fila].length; columna++) {
                System.out.print("Valor [" + fila + "][" + columna + "]: ");
                int numero = entrada.nextInt();
                matriz[fila][columna] = numero + (fila * columna);
            }
        }

        System.out.println("\nMATRIZ MODIFICADA");
        for (int[] fila : matriz) {
            for (int valor : fila) System.out.print(valor + "\t");
            System.out.println();
        }
        entrada.close();
    }
}
