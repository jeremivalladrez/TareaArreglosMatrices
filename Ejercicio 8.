package tarea.arreglo.matrices;

import java.util.Scanner;

/**
 * Muestra y suma la diagonal principal de una matriz de cuatro por cuatro.
 *
 * @author Jeremy Joel Valladarez Caballero
 */
public class Ejercicio8 {
    public static void main(String[] args) {
        Scanner entrada = new Scanner(System.in);
        int[][] matriz = new int[4][4];
        int sumaDiagonal = 0;

        System.out.println("DIAGONAL PRINCIPAL DE UNA MATRIZ 4 X 4");
        for (int fila = 0; fila < matriz.length; fila++) {
            for (int columna = 0; columna < matriz[fila].length; columna++) {
                System.out.print("Valor [" + fila + "][" + columna + "]: ");
                matriz[fila][columna] = entrada.nextInt();
            }
        }

        System.out.println("\nELEMENTOS DE LA DIAGONAL PRINCIPAL");
        for (int i = 0; i < matriz.length; i++) {
            System.out.println("Matriz[" + i + "][" + i + "] = " + matriz[i][i]);
            sumaDiagonal += matriz[i][i];
        }
        System.out.println("Suma de la diagonal principal: " + sumaDiagonal);
        entrada.close();
    }
}
