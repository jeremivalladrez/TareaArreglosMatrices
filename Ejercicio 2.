package tarea.arreglo.matrices;

import java.util.Scanner;

/**
 * Solicita diez números reales y calcula su suma y promedio.
 *
 * @author Jeremy Joel Valladarez Caballero
 */
public class Ejercicio2 {
    public static void main(String[] args) {
        Scanner entrada = new Scanner(System.in);
        double[] numeros = new double[10];
        double suma = 0;

        System.out.println("SUMA Y PROMEDIO DE 10 NÚMEROS REALES");
        for (int i = 0; i < numeros.length; i++) {
            System.out.print("Ingrese el número " + (i + 1) + ": ");
            numeros[i] = entrada.nextDouble();
            suma += numeros[i];
        }

        double promedio = suma / numeros.length;
        System.out.println("\nSuma total: " + suma);
        System.out.println("Promedio: " + promedio);
        entrada.close();
    }
}
