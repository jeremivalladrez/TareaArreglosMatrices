package tarea.arreglo.matrices;

import java.util.Scanner;

/**
 * Solicita diez números enteros y muestra cada valor con su posición.
 *
 * @author Jeremy Joel Valladarez Caballero
 */
public class Ejercicio1 {
    public static void main(String[] args) {
        Scanner entrada = new Scanner(System.in);
        int[] numeros = new int[10];

        System.out.println("INGRESO Y VISUALIZACIÓN DE 10 NÚMEROS");
        for (int i = 0; i < numeros.length; i++) {
            System.out.print("Ingrese el número de la posición " + i + ": ");
            numeros[i] = entrada.nextInt();
        }

        System.out.println("\nVALORES ALMACENADOS");
        for (int i = 0; i < numeros.length; i++) {
            System.out.println("Posición " + i + ": " + numeros[i]);
        }
        entrada.close();
    }
}
